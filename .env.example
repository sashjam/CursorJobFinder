# =============================================================================
# JobDesk — скопируйте в файл .env (без .example) в этой же папке, что main.py
# Без кавычек, без пробелов вокруг =, по одной переменной на строку
# =============================================================================

# BOT — ваш Telegram chat id (ЧИСЛО), куда слать сообщения
#   • личный чат: узнайте у https://t.me/userinfobot → Id
#   • пример: 987654321
#   • группа: отрицательное число, например -1001234567890
# НЕ пишите сюда @username бота и не путайте с BOT_NAME
BOT=987654321

# BOT_NAME — любая подпись в тексте сообщений (не @username)
BOT_NAME=JobDesk

# BOT_TOKEN — токен от @BotFather после /newbot
#   формат: цифры:буквы_и_цифры, длина ~45+ символов
#   пример: 7123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
BOT_TOKEN=7123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw

# --- альтернативные имена (можно вместо BOT / BOT_TOKEN) ---
# TELEGRAM_CHAT_ID=987654321
# TELEGRAM_BOT_TOKEN=7123456789:AAH...

# --- опционально: HeadHunter API ---
# JOBDESK_HH_USER_AGENT=JobDesk/1.0 (your@email.com)
